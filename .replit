entrypoint = "index.html"
modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_11"
packages = ["static-web-server"]

[deployment]
deploymentTarget = "vm"
run = ["node", "server.js"]
build = ["npm", "install"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80

[agent]
expertMode = true
integrations = ["resend:1.0.0"]

[userenv]

[userenv.shared]
RESEND_FROM = "onboarding@resend.dev"
RESEND_TO = "consultantcalatorii@gmail.com"
APP_URL = "https://strategic-flow-audit.replit.app"
WHY_CREDITS_PRICE_ID = "price_1TxF13DpTwoDeZJn43U5Wfmz"
ADMIN_EMAILS = "strategicflow@proton.me,consultantcalatorii@gmail.com,alex@strategicflow.tech"
LIFECYCLE_OUTREACH_PAUSED = "true"

[userenv.production]
STEP3_CAMPAIGN_SCHEDULER_ENABLED = "false"
TOOLINDEX_DRAFT_OUTREACH_SCHEDULER_ENABLED = "true"
STRATEGIC_FLOW_MCP_TEMPORARY_VOTE_SEED_ENABLED = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
